{
  "name": "trackdub-api",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "type": "module",
  "description": "api.trackdub.com — Cloudflare Worker backend (Better Auth + D1 + Drizzle) for the Trackdub portal.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply trackdub_api --local",
    "db:migrate:remote": "wrangler d1 migrations apply trackdub_api --remote",
    "cf-typegen": "wrangler types",
    "dev:docs-rag": "wrangler dev --config wrangler.docs-rag.jsonc",
    "deploy:docs-rag": "wrangler deploy --config wrangler.docs-rag.jsonc",
    "dev:activation": "wrangler dev --config wrangler.activation.jsonc",
    "deploy:activation": "wrangler deploy --config wrangler.activation.jsonc",
    "deploy:activation:staging": "wrangler deploy --config wrangler.activation.staging.jsonc",
    "test:activation": "vitest run --config vitest.activation.config.ts",
    "test:activation:watch": "vitest --config vitest.activation.config.ts",
    "db:generate:activation": "drizzle-kit generate --config drizzle-activation.config.ts",
    "db:migrate:activation:local": "wrangler d1 migrations apply trackdub_activation --local --config wrangler.activation.jsonc",
    "db:migrate:activation:remote": "wrangler d1 migrations apply trackdub_activation --remote --config wrangler.activation.jsonc",
    "db:migrate:activation:staging:remote": "wrangler d1 migrations apply trackdub_activation_staging --remote --config wrangler.activation.staging.jsonc",
    "test:all": "bun run test && bun run test:activation"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "^0.24.0",
    "better-auth": "1.6.25",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.8",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "5.20260922.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.124.0"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": {
      "zod": "3.25.76"
    }
  }
}
