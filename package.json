{
  "name": "trackdub-api",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.0",
  "type": "module",
  "description": "api.trackdub.com: Hono + Better Auth + PostgreSQL (Drizzle) backend for the Trackdub portal, plus the license activation service. Runs on AWS ECS Fargate; docs-rag stays a Cloudflare Worker.",
  "scripts": {
    "dev": "bun run --watch server/main.ts",
    "start": "bun run server/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:activation": "vitest run --config vitest.activation.config.ts",
    "test:activation:watch": "vitest --config vitest.activation.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "bun run test && bun run test:activation",
    "db:generate": "drizzle-kit generate",
    "db:generate:activation": "drizzle-kit generate --config drizzle-activation.config.ts",
    "db:migrate": "SERVICE=api bun run server/migrate.ts",
    "db:migrate:activation": "SERVICE=activation bun run server/migrate.ts",
    "d1:export": "bun run server/d1-migrate.ts export",
    "d1:import": "bun run server/d1-migrate.ts import",
    "dev:docs-rag": "wrangler dev --config wrangler.docs-rag.jsonc",
    "deploy:docs-rag": "wrangler deploy --config wrangler.docs-rag.jsonc",
    "cf-typegen": "wrangler types",
    "legacy:dev": "wrangler dev",
    "legacy:deploy": "wrangler deploy",
    "legacy:dev:activation": "wrangler dev --config wrangler.activation.jsonc",
    "legacy:deploy:activation": "wrangler deploy --config wrangler.activation.jsonc",
    "legacy:deploy:activation:staging": "wrangler deploy --config wrangler.activation.staging.jsonc",
    "legacy:db:migrate:local": "wrangler d1 migrations apply trackdub_api --local",
    "legacy:db:migrate:remote": "wrangler d1 migrations apply trackdub_api --remote",
    "legacy:db:migrate:activation:local": "wrangler d1 migrations apply trackdub_activation --local --config wrangler.activation.jsonc",
    "legacy:db:migrate:activation:remote": "wrangler d1 migrations apply trackdub_activation --remote --config wrangler.activation.jsonc",
    "legacy:db:migrate:activation:staging:remote": "wrangler d1 migrations apply trackdub_activation_staging --remote --config wrangler.activation.staging.jsonc"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1154.0",
    "@cloudflare/workerd-linux-64": "^1.20260731.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "^0.24.0",
    "better-auth": "1.6.25",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.8",
    "postgres": "^3.4.9",
    "present": "^1.0.0",
    "scripts": "^0.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260922.1",
    "@electric-sql/pglite": "^0.5.10",
    "@types/node": "^26.6.5",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.124.0"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true,
    "sharp": true,
    "@cloudflare/workerd-linux-64": true,
    "@cloudflare/workerd-windows-64": true,
    "es5-ext@0.10.64": true
  },
  "overrides": {
    "@modelcontextprotocol/sdk": {
      "zod": "3.25.76"
    }
  }
}
