{
  "name": "trackdub-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "api.trackdub.com — Cloudflare Worker backend (Better Auth + D1 + Drizzle) for the Trackdub portal.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply trackdub_api --local",
    "db:migrate:remote": "wrangler d1 migrations apply trackdub_api --remote",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "better-auth": "^1.3.10",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.9.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@cloudflare/workers-types": "^5.20260722.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.28.0"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true,
    "sharp": true,
    "@cloudflare/workerd-linux-64": true,
    "@cloudflare/workerd-windows-64": true
  }
}
