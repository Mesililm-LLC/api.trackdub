{
  "name": "trackdub-api",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.0",
  "type": "module",
  "description": "api.trackdub.com — Cloudflare Worker backend (Better Auth + D1 + Drizzle) for the Trackdub portal.",
  "scripts": {
    "dev": "cf dev",
    "build": "cf build",
    "deploy": "cf deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "cf d1 migrations apply 073c0238-db61-40d3-b1ee-3e7555493a72 --local --dir drizzle",
    "db:migrate:remote": "cf d1 migrations apply 073c0238-db61-40d3-b1ee-3e7555493a72 --dir drizzle",
    "cf-typegen": "cf workers types",
    "dev:docs-rag": "wrangler dev --config wrangler.docs-rag.jsonc",
    "deploy:docs-rag": "wrangler deploy --config wrangler.docs-rag.jsonc",
    "dev:activation": "cf dev --mode activation",
    "dev:activation:local": "cf dev --mode activation-local --port 8787",
    "deploy:activation": "cf deploy --mode activation",
    "deploy:activation:staging": "cf deploy --mode activation-staging",
    "test:activation": "vitest run --config vitest.activation.config.ts",
    "test:activation:watch": "vitest --config vitest.activation.config.ts",
    "db:generate:activation": "drizzle-kit generate --config drizzle-activation.config.ts",
    "db:migrate:activation:local": "cf d1 migrations apply f95337b1-aff5-455d-a0f9-3293211b1727 --local --dir drizzle-activation",
    "db:seed:activation:dev-license": "cf d1 query f95337b1-aff5-455d-a0f9-3293211b1727 --local --sql \"INSERT OR IGNORE INTO licenses (id, key_hash, tier, buyer_email, status, max_machines) VALUES ('00000000-0000-4000-8000-0000000dev01', '9a9409fd533db04c6c52af636bf999ff88a03f0d1e0a549244093c90ef0ca49e', 'pro', 'dev@local', 'active', 1)\"",
    "db:migrate:activation:remote": "cf d1 migrations apply f95337b1-aff5-455d-a0f9-3293211b1727 --dir drizzle-activation",
    "db:migrate:activation:staging:remote": "cf d1 migrations apply d694b5d9-3c04-4534-a9cd-6892967fb5ee --dir drizzle-activation",
    "test:all": "bun run test && bun run test:activation"
  },
  "dependencies": {
    "@cloudflare/workerd-linux-64": "^1.20260731.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "^0.24.0",
    "better-auth": "1.6.25",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.8",
    "present": "^1.0.0",
    "scripts": "^0.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "5.20260922.1",
    "cf": "^1.0.0-beta.21",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.152.0"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true,
    "sharp": true,
    "@cloudflare/workerd-linux-64": true,
    "@cloudflare/workerd-windows-64": true,
    "es5-ext@0.10.64": true
  },
  "overrides": {
    "@modelcontextprotocol/sdk": {
      "zod": "3.25.76"
    }
  }
}
