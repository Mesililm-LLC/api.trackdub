{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trackdub-docs-rag",
  "main": "src/docs-rag/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "workers_dev": true,
  "ai": {
    "binding": "AI"
  },
  "r2_buckets": [
    {
      "binding": "CORPUS",
      "bucket_name": "trackdub-docs-corpus"
    }
  ],
  "ratelimits": [
    {
      "name": "RL_BURST",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 10 }
    },
    {
      "name": "RL_STEADY",
      "namespace_id": "1002",
      "simple": { "limit": 300, "period": 60 }
    },
    {
      "name": "RL_ASK",
      "namespace_id": "1003",
      "simple": { "limit": 5, "period": 10 }
    }
  ],
  "vars": {
    "AI_SEARCH_INSTANCE": "trackdub-docs",
    "AI_SEARCH_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "CF_ACCOUNT_ID": "21cac5947e11018d571c18792118b8b0"
  }
}
