{
  // Cloudflare Worker: api.trackdub.com
  // Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trackdub-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "workers_dev": false,
  "routes": [
    {
      "pattern": "api.trackdub.com",
      "custom_domain": true
    }
  ],
  // Public (non-secret) configuration. Secrets go in .dev.vars (local) and
  // `wrangler secret put` (deployed) — never here.
  "vars": {
    "APP_ENV": "production",
    "PORTAL_ORIGIN": "https://portal.trackdub.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trackdub_api",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "trackdub-media"
    }
  ]
}
