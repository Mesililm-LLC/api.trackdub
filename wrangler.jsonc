{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trackdub-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-08-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "workers_dev": false,
  "routes": [
    {
      "pattern": "api.trackdub.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "APP_ENV": "production",
    "PORTAL_ORIGIN": "https://portal.trackdub.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trackdub_api",
      "database_id": "073c0238-db61-40d3-b1ee-3e7555493a72",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "trackdub-media"
    }
  ]
}